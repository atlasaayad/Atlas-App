# Copy to .env for local dev (node --watch server/src/index.js reads it via dotenv).
# On Vercel, set these as Project → Settings → Environment Variables instead —
# DATABASE_URL/POSTGRES_URL is set automatically if you add the Neon
# integration from the Vercel Storage tab.

DATABASE_URL=postgres://user:password@localhost:5432/atlas

# Required — the app refuses to start without a real value here (no
# insecure fallback). Generate one with: openssl rand -hex 32
JWT_SECRET=

COMPANY_NAME=Casual
PORT=4000

# Optional — enables the "Ask Atlas" AI assistant. Without it, /api/ask
# returns 503 ai_not_configured and the UI degrades gracefully.
# ANTHROPIC_API_KEY=

# Optional — Ask Atlas questions allowed per factory-local day, system-wide.
# Defaults to 100.
# ASK_DAILY_LIMIT=100

# Optional — enables the model-photo upload on Agent Méthode's Identité tab
# (PUT/DELETE /api/methode/models/:id/image). Auto-injected by Vercel once a
# Blob store is connected under Project → Storage → Create Database → Blob;
# nothing to set manually there. Without it, upload returns 503
# storage_not_configured and the identity card just renders without a photo
# — model creation/editing itself is completely unaffected either way.
# BLOB_READ_WRITE_TOKEN=

# Optional — Fiche Modèle customer documents (confidential). A SEPARATE,
# PRIVATE Vercel Blob store (atlas-documents), never the public photo store
# above. Server-side only: never prefix with VITE_, never sent to the
# browser — the browser only ever gets a short-lived presigned URL for one
# upload (5 min) or one read (2 min). Without DOCS_BLOB_READ_WRITE_TOKEN the
# Fiche still works and its documents section shows "Stockage des documents
# non configuré". Auto-injected by Vercel when the store is connected with
# the DOCS_BLOB prefix.
# DOCS_BLOB_READ_WRITE_TOKEN=
# DOCS_BLOB_STORE_ID=
# DOCS_BLOB_WEBHOOK_PUBLIC_KEY=

# Optional — which browser origins may call the API cross-origin (see
# server/src/cors.js). Same-origin requests are always allowed. Defaults:
# https://atlas-app-smoky.vercel.app, plus this Vercel team's preview URLs
# for the atlas-app project. Setting a variable REPLACES
# its default. Any other origin gets 403 origin_not_allowed.
# CORS_ALLOWED_ORIGINS=https://atlas-app-smoky.vercel.app
# CORS_PREVIEW_ORIGIN_PATTERN=^https://atlas-app-[a-z0-9-]+-atlasaayads-projects\.vercel\.app$

# Per-department PINs. In production (VERCEL_ENV/NODE_ENV = production) the
# server logs a loud warning at boot for every one that is missing, because
# a missing one falls back to the publicly known default below.
# Optional per-department PIN overrides. Re-synced to the database on every
# boot, so changing one of these (or the DEFAULT_PINS in server/src/db/seed.js
# if you're not using env vars) and redeploying is enough to rotate a PIN,
# even on an already-seeded database.
# PIN_METHODE=1111
# PIN_PRODUCTION=2222
# PIN_PATRON=3333
# PIN_MECANICIEN=4444
# PIN_MAGASIN=5555
# PIN_LOGISTICS=6666
# PIN_QUALITY=7777
# PIN_RH=8888
# PIN_COUPE=9999
# PIN_DEPOT=1010
# PIN_FINALE=1313
# PIN_ECHANTILLON=1212
