# Copy to .env for local dev (node --watch server/src/index.js reads it via dotenv).
# On Vercel, set these as Project → Settings → Environment Variables instead —
# DATABASE_URL/POSTGRES_URL is set automatically if you add the Neon
# integration from the Vercel Storage tab.

DATABASE_URL=postgres://user:password@localhost:5432/atlas

# Required — the app refuses to start without a real value here (no
# insecure fallback). Generate one with: openssl rand -hex 32
JWT_SECRET=

COMPANY_NAME=Casual
PORT=4000

# Optional — enables the "Ask Atlas" AI assistant. Without it, /api/ask
# returns 503 ai_not_configured and the UI degrades gracefully.
# ANTHROPIC_API_KEY=

# Optional — Ask Atlas questions allowed per factory-local day, system-wide.
# Defaults to 100.
# ASK_DAILY_LIMIT=100

# Required for ATLAS PREDICT's "Live Matches" tab (client/src/predict) to
# fetch real fixtures/standings/form from football-data.org. Free tier key —
# get one at https://www.football-data.org/client/register. Without it,
# /api/predict/leagues and /api/predict/matches return 503 and the UI
# degrades gracefully (manual match entry still works normally).
# Deliberately NOT prefixed VITE_ — this is read server-side only
# (server/src/routes/predict.js via process.env), never bundled into the
# client, so it must not carry Vite's client-exposure prefix.
# FOOTBALL_DATA_KEY=

# Optional — reuses the same ANTHROPIC_API_KEY as Ask Atlas above. Without
# it, /api/predict/analyze returns 503 and the "تحليل وتوقعات" button shows
# a clear "not configured" message instead of erroring.

# Optional — AI match-analysis reports allowed per factory-local day,
# system-wide (protects against runaway Anthropic API spend on the
# heavier claude-sonnet-5 report-generation calls). Defaults to 50.
# PREDICT_ANALYSIS_DAILY_LIMIT=50

# Optional per-department PIN overrides. Re-synced to the database on every
# boot, so changing one of these (or the DEFAULT_PINS in server/src/db/seed.js
# if you're not using env vars) and redeploying is enough to rotate a PIN,
# even on an already-seeded database.
# PIN_METHODE=1111
# PIN_PRODUCTION=2222
# PIN_PATRON=3333
# PIN_MECANICIEN=4444
# PIN_MAGASIN=5555
# PIN_LOGISTICS=6666
# PIN_QUALITY=7777
# PIN_RH=8888
# PIN_COUPE=9999
# PIN_DEPOT=1010
# PIN_FINALE=1313
# PIN_ECHANTILLON=1212
