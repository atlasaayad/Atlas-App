# Copy to .env for local dev (node --watch server/src/index.js reads it via dotenv).
# On Vercel, set these as Project → Settings → Environment Variables instead —
# DATABASE_URL/POSTGRES_URL is set automatically if you add the Neon
# integration from the Vercel Storage tab.

DATABASE_URL=postgres://user:password@localhost:5432/atlas
JWT_SECRET=change-me-in-production
COMPANY_NAME=ATLAS
PORT=4000

# Optional per-department PIN overrides. Re-synced to the database on every
# boot, so changing one of these (or the DEFAULT_PINS in server/src/db/seed.js
# if you're not using env vars) and redeploying is enough to rotate a PIN,
# even on an already-seeded database.
# PIN_METHODE=1111
# PIN_PRODUCTION=2222
# PIN_PATRON=3333
# PIN_MECANICIEN=4444
# PIN_MAGASIN=5555
# PIN_LOGISTICS=6666
# PIN_QUALITY=7777
# PIN_RH=8888
# PIN_COUPE=9999
# PIN_DEPOT=1010
# PIN_FINALE=1111
# PIN_ECHANTILLON=1212
