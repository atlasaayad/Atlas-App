# Copy to .env for local dev (node --watch server/src/index.js reads it via dotenv).
# On Vercel, set these as Project → Settings → Environment Variables instead —
# DATABASE_URL/POSTGRES_URL is set automatically if you add the Neon
# integration from the Vercel Storage tab.

DATABASE_URL=postgres://user:password@localhost:5432/atlas
JWT_SECRET=change-me-in-production
COMPANY_NAME=ATLAS
PORT=4000

# Optional per-department PIN overrides used only the first time the app
# seeds a fresh database (existing departments are left untouched).
# PIN_METHODE=1001
# PIN_PRODUCTION=1002
# PIN_PATRON=1003
# PIN_MECANICIEN=1004
# PIN_MAGASIN=1005
# PIN_LOGISTICS=1006
# PIN_QUALITY=1007
# PIN_RH=1008
# PIN_COUPE=1009
# PIN_DEPOT=1010
# PIN_FINALE=1011
# PIN_ECHANTILLON=1012
