# انسخ هذا الملف إلى .env للتشغيل محلياً. على Railway، اضبط هذه المتغيرات
# من Project → Variables بدلاً من ملف .env (لا ترفع .env أبداً إلى git).

# من BotFather بعد إنشاء البوت
TELEGRAM_BOT_TOKEN=

# معرّف المحادثة التي سيرسل إليها البوت التحليلات والنتائج
TELEGRAM_CHAT_ID=

# مفتاح مجاني من https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# مفتاح Anthropic API (لتوليد التحليل والتوقع عبر البحث على الويب)
ANTHROPIC_API_KEY=

# اختياري — النموذج المستخدم للتحليل. الافتراضي هو الأقوى (الأدق لكن الأغلى).
# للتكلفة الأقل: claude-sonnet-5 أو claude-haiku-4-5
ANALYSIS_MODEL=claude-opus-5

# اختياري — المنطقة الزمنية المستخدمة في عرض مواعيد المباريات وجدولة
# الإحصاء الأسبوعي (كل إثنين 08:00 بهذا التوقيت)
TIMEZONE=Africa/Cairo

# اختياري — مجلد تخزين قاعدة بيانات SQLite (سجل التوقعات والإحصاءات).
# على Railway اربطه بـ Volume دائم حتى لا يُفقد السجل عند كل إعادة نشر.
DATA_DIR=./data
